# Build-time override for the CadenceEngineer web application origin.
PUBLIC_APP_ORIGIN=http://localhost:5173

# Show links from the public site to the CadenceEngineer web application.
PUBLIC_APP_LINKS_ENABLED=true

# Absolute origin of this site, used in social-preview metadata.
PUBLIC_SITE_ORIGIN=https://cadence.engineer

# Show the Basic, Premium, and Enterprise pricing section on the home page.
PUBLIC_PRICING_ENABLED=false

# Development only: forward the contact form to a local API through the Vite dev server, standing
# in for the production Caddy proxy. Neither value is embedded into the built site. The origin is
# scheme, host, and optional port only, without a trailing slash.
CONTACT_API_ORIGIN=http://localhost:8080
CONTACT_SITE_SECRET=development-only-contact-site-secret
